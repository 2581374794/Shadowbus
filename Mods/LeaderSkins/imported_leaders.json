 "emote_text": {
  "ET_サレンダー敗北_1110": {
   "chs": "我们不会分开……",
   "cht": "我们不会分开……",
   "eng": "",
   "jpn": "分かたれることはない……。"
  },
  "ET_サレンダー敗北_1520": {
   "chs": "真的是没办法啦！",
   "cht": "真的是没办法啦！",
   "eng": "",
   "jpn": "まいりましたぁ～！"
  },
  "ET_サレンダー敗北_1530": {
   "chs": "不需要什么光明……",
   "cht": "不需要什么光明……",
   "eng": "",
   "jpn": "光などいらぬ……。"
  },
  "ET_サレンダー敗北_99002": {
   "chs": "我竟然…玩脱了……",
   "cht": "我竟然…玩脫了……",
   "eng": "",
   "jpn": "俺としたことが…はしゃぎすぎだか……！"
  },
  "ET_サレンダー敗北_99003": {
   "chs": "亏、亏大了…呢……",
   "cht": "虧、虧大了…呢……",
   "eng": "",
   "jpn": "割に合わない、ですね……"
  },
  "ET_サレンダー敗北_99004": {
   "chs": "可恶…抱歉了，各位…",
   "cht": "可惡…抱歉了，各位…",
   "eng": "",
   "jpn": "くそ…皆すまない…"
  },
  "ET_サレンダー敗北_99007": {
   "chs": "没…没力气了啦…",
   "cht": "沒…沒力氣了啦…",
   "eng": "",
   "jpn": "力が…入らない…"
  },
  "ET_困惑_1110": {
   "chs": "明明已经到手了……",
   "cht": "明明已经到手了……",
   "eng": "",
   "jpn": "既に我が手中……。"
  },
  "ET_困惑_1520": {
   "chs": "嗯……",
   "cht": "嗯……",
   "eng": "",
   "jpn": "うーん……。"
  },
  "ET_困惑_1530": {
   "chs": "嗯……",
   "cht": "嗯……",
   "eng": "",
   "jpn": "フン……。"
  },
  "ET_困惑_99002": {
   "chs": "要和大家保密哦~",
   "cht": "要和大家保密哦~",
   "eng": "",
   "jpn": "みんなには内緒にしておいてくれよ"
  },
  "ET_困惑_99003": {
   "chs": "我果然不是这块料呢…",
   "cht": "我果然不是這塊料呢…",
   "eng": "",
   "jpn": "やっぱ柄じゃないんですよ…"
  },
  "ET_困惑_99004": {
   "chs": "要我认输还早着呢！",
   "cht": "要我認輸還早著呢！",
   "eng": "",
   "jpn": "まだ早いと思うがね！"
  },
  "ET_困惑_99007": {
   "chs": "这个是…啥？",
   "cht": "這個是…啥？",
   "eng": "",
   "jpn": "何かしら、アレ"
  },
  "ET_感謝_1110": {
   "chs": "哦。",
   "cht": "哦。",
   "eng": "",
   "jpn": "ほぅ。"
  },
  "ET_感謝_1520": {
   "chs": "真的很温暖呢！",
   "cht": "真的很温暖呢！",
   "eng": "",
   "jpn": "ほっこりするね！"
  },
  "ET_感謝_1530": {
   "chs": "真是难得。",
   "cht": "真是難得。",
   "eng": "",
   "jpn": "ありがたいな。"
  },
  "ET_感謝_99002": {
   "chs": "帮大忙了！",
   "cht": "幫大忙了！",
   "eng": "",
   "jpn": "助かった！"
  },
  "ET_感謝_99003": {
   "chs": "好活哟！",
   "cht": "好活喲！",
   "eng": "",
   "jpn": "ナイスですよ！"
  },
  "ET_感謝_99004": {
   "chs": "干得漂亮。",
   "cht": "幹得漂亮。",
   "eng": "",
   "jpn": "なかなかやるね"
  },
  "ET_感謝_99007": {
   "chs": "谢谢！",
   "cht": "謝謝！",
   "eng": "",
   "jpn": "ありがとっ！"
  },
  "ET_挑発_1110": {
   "chs": "劫火永焚，刹那冰封！",
   "cht": "劫火永焚，刹那冰封！",
   "eng": "",
   "jpn": "永久に焼かれ、刹那に凍れ！"
  },
  "ET_挑発_1520": {
   "chs": "幸福的大合唱要来啰！",
   "cht": "幸福的大合唱要来啰！",
   "eng": "",
   "jpn": "幸せの大合唱ー！"
  },
  "ET_挑発_1530": {
   "chs": "在虚无的永眠中沉沦吧。",
   "cht": "在虛無的永眠中沉淪吧。",
   "eng": "",
   "jpn": "虚無に抱かれて眠るがいい。"
  },
  "ET_挑発_99002": {
   "chs": "让你见识见识圆桌骑士真正的实力！",
   "cht": "讓你見識見識圓桌騎士真正的實力！",
   "eng": "",
   "jpn": "円卓の騎士の底力を見せてやれ！"
  },
  "ET_挑発_99003": {
   "chs": "好，整活咯——！",
   "cht": "好，整活咯——！",
   "eng": "",
   "jpn": "よーし、行きますよ"
  },
  "ET_挑発_99004": {
   "chs": "奋起反击吧，我的骑士！",
   "cht": "奮起反擊吧，我的騎士！",
   "eng": "",
   "jpn": "奮い立て、我が騎士たちよ！"
  },
  "ET_挑発_99007": {
   "chs": "来，整活了哟~",
   "cht": "來，整活了喲~",
   "eng": "",
   "jpn": "さ、行くわよ"
  },
  "ET_挨拶_1110": {
   "chs": "你要阻挡我吗？",
   "cht": "你要阻挡我吗？",
   "eng": "",
   "jpn": "立ちはだかるか。"
  },
  "ET_挨拶_1520": {
   "chs": "钟声很好听吧！",
   "cht": "钟声很好听吧！",
   "eng": "",
   "jpn": "きれーな音でしょ！"
  },
  "ET_挨拶_1530": {
   "chs": "无需保留。",
   "cht": "无需保留。",
   "eng": "",
   "jpn": "容赦は無い。"
  },
  "ET_挨拶_99002": {
   "chs": "多指教啦~",
   "cht": "多指教啦~",
   "eng": "",
   "jpn": "よろしくな"
  },
  "ET_挨拶_99003": {
   "chs": "请多指教~",
   "cht": "請多指教~",
   "eng": "",
   "jpn": "よろしくです"
  },
  "ET_挨拶_99004": {
   "chs": "请你多多指教。",
   "cht": "請你多多指教。",
   "eng": "",
   "jpn": "よろしく頼む"
  },
  "ET_挨拶_99007": {
   "chs": "多多指教~",
   "cht": "多多指教~",
   "eng": "",
   "jpn": "よろしくね"
  },
  "ET_敗北_1110": {
   "chs": "下次我们二人一定……",
   "cht": "下次我们二人一定……",
   "eng": "",
   "jpn": "今度こそ、二人で……。"
  },
  "ET_敗北_1520": {
   "chs": "下次一定把钟声传递到你那边！",
   "cht": "下次一定把钟声传递到你那边！",
   "eng": "",
   "jpn": "次は届けるから～！"
  },
  "ET_敗北_1530": {
   "chs": "再一次堕落吗……",
   "cht": "再一次堕落吗……",
   "eng": "",
   "jpn": "再び堕ちるか……。"
  },
  "ET_敗北_99002": {
   "chs": "可恶、竟然在这种地方……！",
   "cht": "可惡、竟然在這種地方……！",
   "eng": "",
   "jpn": "くそっ、こんなところで……！"
  },
  "ET_敗北_99003": {
   "chs": "没、没能得逞……",
   "cht": "沒、沒能得逞……",
   "eng": "",
   "jpn": "け、計算を間違えましたね…"
  },
  "ET_敗北_99004": {
   "chs": "唔…是我失算了呢……",
   "cht": "唔…是我失算了呢……",
   "eng": "",
   "jpn": "くっ、計算を間違えたかね……"
  },
  "ET_敗北_99007": {
   "chs": "真叫人不敢相信……",
   "cht": "真叫人不敢相信……",
   "eng": "",
   "jpn": "信じられない……"
  },
  "ET_謝罪_1110": {
   "chs": "这还真是遗憾呢。",
   "cht": "这还真是遗憾呢。",
   "eng": "",
   "jpn": "残念だ。"
  },
  "ET_謝罪_1520": {
   "chs": "可怜巴巴的叮当……",
   "cht": "可怜巴巴的叮当……",
   "eng": "",
   "jpn": "しょんぼり……。"
  },
  "ET_謝罪_1530": {
   "chs": "别怨我。",
   "cht": "別怨我。",
   "eng": "",
   "jpn": "悪く思うな。"
  },
  "ET_謝罪_99002": {
   "chs": "别冲太前了！",
   "cht": "別沖太前了！",
   "eng": "",
   "jpn": "あんまり前に出すぎるな！"
  },
  "ET_謝罪_99003": {
   "chs": "真是…好难缠！",
   "cht": "真是…好難纏！",
   "eng": "",
   "jpn": "諦めが悪いんですよね"
  },
  "ET_謝罪_99004": {
   "chs": "身为王，怎么可以在此轻言放弃……！",
   "cht": "身為王，怎麼可以在此輕言放棄……！",
   "eng": "",
   "jpn": "ここであきらめるようなら…王など"
  },
  "ET_謝罪_99007": {
   "chs": "呼…太好了。",
   "cht": "呼…太好了。",
   "eng": "",
   "jpn": "ふぅ…よかった"
  },
  "ET_賞賛_1110": {
   "chs": "了不起。",
   "cht": "了不起。",
   "eng": "",
   "jpn": "大したものだ。"
  },
  "ET_賞賛_1520": {
   "chs": "真是纯洁的心灵呢！",
   "cht": "真是纯洁的心灵呢！",
   "eng": "",
   "jpn": "きれーな心だね！"
  },
  "ET_賞賛_1530": {
   "chs": "还要垂死挣扎吗。",
   "cht": "還要垂死掙扎嗎。",
   "eng": "",
   "jpn": "まだ足掻くか。"
  },
  "ET_賞賛_99002": {
   "chs": "你很懂嘛！",
   "cht": "你很懂嘛！",
   "eng": "",
   "jpn": "上手いぞ！"
  },
  "ET_賞賛_99003": {
   "chs": "那我…就在后面悄咪咪地支援你啦~",
   "cht": "那我…就在後面悄咪咪地支援你啦~",
   "eng": "",
   "jpn": "後ろ…こそこそ応援してますからね。"
  },
  "ET_賞賛_99004": {
   "chs": "看起来不赖嘛！",
   "cht": "看起來不賴嘛！",
   "eng": "",
   "jpn": "悪くはないようだね！"
  },
  "ET_賞賛_99007": {
   "chs": "打起精神来整活了哟！",
   "cht": "打起精神來整活了喲！",
   "eng": "",
   "jpn": "テンション上げていくわよ！"
  },
  "ET_進化1_1110": {
   "chs": "狂舞吧，火炎。",
   "cht": "狂舞吧，火炎。",
   "eng": "",
   "jpn": "炎よ狂え。"
  },
  "ET_進化1_1520": {
   "chs": "汇聚美好的愿望！",
   "cht": "汇聚美好的愿望！",
   "eng": "",
   "jpn": "願いが集まる！"
  },
  "ET_進化1_1530": {
   "chs": "光明可溃。",
   "cht": "光明可潰。",
   "eng": "",
   "jpn": "光は潰える。"
  },
  "ET_進化1_99002": {
   "chs": "尝尝这招！",
   "cht": "嘗嘗這招！",
   "eng": "",
   "jpn": "こいつはどうかな！"
  },
  "ET_進化1_99003": {
   "chs": "这招怎么样啊？",
   "cht": "這招怎麼樣啊？",
   "eng": "",
   "jpn": "こいつはどうですか？"
  },
  "ET_進化1_99004": {
   "chs": "这招又如何呢？",
   "cht": "這招又如何呢？",
   "eng": "",
   "jpn": "これはどうかね？"
  },
  "ET_進化1_99007": {
   "chs": "我可是会结结实实地揍你的哦！",
   "cht": "我可是會結結實實地揍你的哦！",
   "eng": "カチカチにしてあげるわ！",
   "jpn": "カチカチにしてあげるわ！"
  },
  "ET_進化2_1110": {
   "chs": "凝结吧，冰霜。",
   "cht": "凝结吧，冰霜。",
   "eng": "",
   "jpn": "氷結せん。"
  },
  "ET_進化2_1520": {
   "chs": "好厉害啊！",
   "cht": "好厉害啊！",
   "eng": "",
   "jpn": "どすこーい！"
  },
  "ET_進化2_1530": {
   "chs": "黑暗将盈。",
   "cht": "黑暗將盈。",
   "eng": "",
   "jpn": "闇よ、此処に。"
  },
  "ET_進化2_99002": {
   "chs": "燃烧殆尽！",
   "cht": "燃燒殆盡！",
   "eng": "",
   "jpn": "燃やし尽くしてやる！"
  },
  "ET_進化2_99003": {
   "chs": "好，请你冻起来咯！",
   "cht": "好，請你凍起來咯！",
   "eng": "",
   "jpn": "よーし、凍っちゃってください！"
  },
  "ET_進化2_99004": {
   "chs": "让你化为灰烬！",
   "cht": "讓你化為灰燼！",
   "eng": "",
   "jpn": "灰にしてやろう！"
  },
  "ET_進化2_99007": {
   "chs": "我可不想认输呢！",
   "cht": "我可不想認輸呢！",
   "eng": "",
   "jpn": "負けられないのよ！"
  },
  "ET_進化3_1110": {
   "chs": "哼，消失吧！",
   "cht": "哼，消失吧！",
   "eng": "",
   "jpn": "さぁ、消え失せろ！"
  },
  "ET_進化3_1520": {
   "chs": "钟声源源不断哦！",
   "cht": "钟声源源不断哦！",
   "eng": "",
   "jpn": "もっともっと鳴らすよ！"
  },
  "ET_進化3_1530": {
   "chs": "赐你灭亡。",
   "cht": "賜你滅亡。",
   "eng": "",
   "jpn": "滅びを与えん。"
  },
  "ET_進化3_99002": {
   "chs": "无论如何都要赢得胜利！",
   "cht": "無論如何都要贏得勝利！",
   "eng": "",
   "jpn": "どんな手を使っても勝ってみせる！"
  },
  "ET_進化3_99003": {
   "chs": "看我麻利地送你上天！",
   "cht": "看我麻利地送你上天！",
   "eng": "",
   "jpn": "ちゃちゃっと吹き飛ばしてあげますよ！"
  },
  "ET_進化3_99004": {
   "chs": "不会让你为所欲为！",
   "cht": "不會讓你為所欲為！",
   "eng": "",
   "jpn": "好き勝手はさせん！"
  },
